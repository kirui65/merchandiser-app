rules_version = '2';

// IMPORTANT: this is a DEFENSE-IN-DEPTH BACKSTOP, not the primary access
// control layer. All writes from the mobile app and admin dashboard go
// through the Express backend using the Firebase Admin SDK, which BYPASSES
// these rules entirely. The real authorization boundary is
// backend/src/middleware/auth.middleware.js and the per-controller scope
// checks (see shared/firestoreSchema.md). These rules exist only in case a
// client SDK integration is added later that talks to Firestore directly —
// do not rely on them, and do not remove backend-side checks because they
// exist.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/reps/$(request.auth.uid)).data.role == 'manager';
    }

    function isTelemarketer() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/reps/$(request.auth.uid)).data.role == 'telemarketer';
    }

    function isBrandAmbassador() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/reps/$(request.auth.uid)).data.role == 'brand_ambassador';
    }

    function isMerchandiser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/reps/$(request.auth.uid)).data.role == 'rep';
    }

    function isTeamLeader() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/reps/$(request.auth.uid)).data.role == 'team_leader';
    }

    function isOwner(repId) {
      return isSignedIn() && request.auth.uid == repId;
    }

    function isTeamLeaderFor(teamId) {
      return teamId is string &&
        isTeamLeader() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.teamLeaderId == request.auth.uid &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.active == true;
    }

    function isActiveTeamMember(teamId) {
      return teamId is string &&
        isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.active == true &&
        exists(/databases/$(database)/documents/teamMemberships/$(teamId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/teamMemberships/$(teamId + '_' + request.auth.uid)).data.status == 'active';
    }

    match /reps/{repId} {
      allow read: if isOwner(repId) || isManager();
      allow write: if isManager();
    }

    match /outlets/{outletId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /territories/{territoryId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /teams/{teamId} {
      allow read: if isManager() || isTeamLeaderFor(teamId) || isActiveTeamMember(teamId);
      allow write: if isManager();
    }

    match /teamMemberships/{membershipId} {
      allow read: if isManager() ||
        (isSignedIn() && resource.data.repId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow write: if isManager();
    }

    match /sales/{saleId} {
      allow read: if isManager() ||
        (isSignedIn() && resource.data.repId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isMerchandiser() &&
        request.resource.data.repId == request.auth.uid &&
        (request.resource.data.get('teamId', null) == null ||
          isActiveTeamMember(request.resource.data.get('teamId', null)));
      allow update: if isManager() ||
        (isMerchandiser() && resource.data.repId == request.auth.uid);
      allow delete: if isManager();
    }

    match /leads/{leadId} {
      allow read: if isManager() ||
        (isTelemarketer() && resource.data.telemarketerId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isManager() ||
        (isTelemarketer() && request.resource.data.telemarketerId == request.auth.uid);
      allow update: if isManager() ||
        (isTelemarketer() &&
          resource.data.telemarketerId == request.auth.uid &&
          request.resource.data.telemarketerId == request.auth.uid);
      allow delete: if isManager();
    }

    match /calls/{callId} {
      allow read: if isManager() ||
        (isTelemarketer() && resource.data.telemarketerId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isManager() ||
        (isTelemarketer() && request.resource.data.telemarketerId == request.auth.uid);
      allow update: if isManager() ||
        (isTelemarketer() &&
          resource.data.telemarketerId == request.auth.uid &&
          request.resource.data.telemarketerId == request.auth.uid);
      allow delete: if isManager();
    }

    match /activations/{activationId} {
      allow read: if isManager() ||
        (isBrandAmbassador() && resource.data.ambassadorId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isManager() ||
        (isBrandAmbassador() &&
          request.resource.data.ambassadorId == request.auth.uid &&
          request.resource.data.status in ['draft', 'submitted']);
      allow update: if isManager() ||
        (isBrandAmbassador() &&
          resource.data.ambassadorId == request.auth.uid &&
          request.resource.data.ambassadorId == request.auth.uid &&
          resource.data.status == 'draft' &&
          request.resource.data.status in ['draft', 'submitted']);
      allow delete: if isManager();
    }

    match /merchandisingAudits/{auditId} {
      allow read: if isManager() ||
        (isMerchandiser() && resource.data.merchandiserId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isMerchandiser() &&
        request.resource.data.merchandiserId == request.auth.uid;
      allow update: if isManager() ||
        (isMerchandiser() &&
          resource.data.merchandiserId == request.auth.uid &&
          request.resource.data.merchandiserId == request.auth.uid);
      allow delete: if isManager() ||
        (isMerchandiser() && resource.data.merchandiserId == request.auth.uid);
    }

    match /competitorPrices/{observationId} {
      allow read: if isManager() ||
        (isMerchandiser() && resource.data.merchandiserId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isMerchandiser() &&
        request.resource.data.merchandiserId == request.auth.uid;
      allow update: if isManager() ||
        (isMerchandiser() &&
          resource.data.merchandiserId == request.auth.uid &&
          request.resource.data.merchandiserId == request.auth.uid);
      allow delete: if isManager() ||
        (isMerchandiser() && resource.data.merchandiserId == request.auth.uid);
    }

    match /outletOnboarding/{requestId} {
      allow read: if isManager() ||
        (isMerchandiser() && resource.data.submittedBy == request.auth.uid);
      allow create: if isMerchandiser() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending_review';
      allow update: if isManager();
      allow delete: if isManager();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isManager() ||
        isTeamLeaderFor(resource.data.get('teamId', null)) ||
        (isActiveTeamMember(resource.data.get('teamId', null)) && resource.data.status == 'published');
      allow create: if isManager() ||
        (isTeamLeaderFor(request.resource.data.teamId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.status == 'draft');
      allow update: if isManager() ||
        (isTeamLeaderFor(resource.data.get('teamId', null)) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.senderId == request.auth.uid);
      allow delete: if isManager() ||
        (isTeamLeaderFor(resource.data.get('teamId', null)) && resource.data.senderId == request.auth.uid);
    }

    match /fieldRequests/{requestId} {
      allow read: if isManager() ||
        (isSignedIn() && resource.data.requesterId == request.auth.uid) ||
        isTeamLeaderFor(resource.data.get('teamId', null));
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        isActiveTeamMember(request.resource.data.teamId) &&
        request.resource.data.status == 'pending';
      allow update: if isManager() ||
        (isTeamLeaderFor(resource.data.get('teamId', null)) &&
          resource.data.status == 'pending' &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.requesterId == resource.data.requesterId);
      allow delete: if isManager() ||
        (isSignedIn() &&
          resource.data.requesterId == request.auth.uid &&
          resource.data.status == 'pending');
    }

    match /routes/{routeId} {
      allow read: if isManager() || (isSignedIn() && resource.data.repId == request.auth.uid);
      allow create, update: if (isMerchandiser() || isBrandAmbassador()) &&
        request.resource.data.repId == request.auth.uid;
      allow delete: if isManager();
    }

    // No client role may ever write mpesaTransactions directly — only the
    // backend (via the Daraja callback, using the Admin SDK) creates these.
    match /mpesaTransactions/{txnId} {
      allow read: if isManager() || (isSignedIn() && resource.data.repId == request.auth.uid);
      allow write: if false;
    }
  }
}
