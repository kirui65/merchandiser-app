{
  "expo": {
    "name": "Brandsphere Marketing Agency",
    "slug": "merchandiser-app",
    "version": "1.0.0",
    "icon": "./assets/brandsphere-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F8FA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture receipt and shelf photos when logging a sale.",
        "NSLocationWhenInUseUsageDescription": "Used to record your route while a shift is active.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to record your route in the background during an active shift (2-5 min pings, not continuous tracking).",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brandsphere-adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.kirui65.merchandiserapp"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b19a1e38-1d39-4e41-880e-341be74978c4"
      }
    },
    "owner": "kirui321"
  }
}
