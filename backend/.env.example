# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Firebase Console > Storage bucket name (for example, <project>.appspot.com)
FIREBASE_STORAGE_BUCKET=

# M-Pesa Daraja API (Phase 3)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_TOKEN=
DARAJA_ENV=sandbox

# Reconciliation (Phase 3)
RECONCILIATION_WINDOW_MINUTES=15
GEOFENCE_RADIUS_METERS=100

# CORS
ALLOWED_ORIGINS=http://localhost:5173
